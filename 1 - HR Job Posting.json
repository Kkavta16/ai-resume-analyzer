{
  "name": "1 - HR Job Posting (Form -> Data Table -> LinkedIn post text)",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Create a Job Opening",
        "formDescription": "HR team: fill in the job details. A LinkedIn hiring post with the application link will be published automatically.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Company Name",
              "requiredField": true
            },
            {
              "fieldLabel": "Job Title",
              "placeholder": "e.g. Data Analyst Intern",
              "requiredField": true
            },
            {
              "fieldLabel": "Location",
              "placeholder": "e.g. Bengaluru, India",
              "requiredField": true
            },
            {
              "fieldLabel": "Employment Type",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Full-time"
                  },
                  {
                    "option": "Part-time"
                  },
                  {
                    "option": "Internship"
                  },
                  {
                    "option": "Contract"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Work Mode",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Onsite"
                  },
                  {
                    "option": "Remote"
                  },
                  {
                    "option": "Hybrid"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Experience Required",
              "placeholder": "e.g. 0-2 years",
              "requiredField": true
            },
            {
              "fieldLabel": "Required Skills",
              "placeholder": "e.g. Python, SQL, Power BI",
              "requiredField": true
            },
            {
              "fieldLabel": "Job Description",
              "fieldType": "textarea",
              "placeholder": "Responsibilities, requirements, perks...",
              "requiredField": true
            },
            {
              "fieldLabel": "JD File (optional)",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".pdf"
            },
            {
              "fieldLabel": "Candidate Fields",
              "fieldType": "dropdown",
              "multiselect": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "Phone"
                  },
                  {
                    "option": "College / University"
                  },
                  {
                    "option": "Degree"
                  },
                  {
                    "option": "Graduation Year"
                  },
                  {
                    "option": "Years of Experience"
                  },
                  {
                    "option": "Current Company"
                  },
                  {
                    "option": "LinkedIn Profile"
                  },
                  {
                    "option": "GitHub / Portfolio"
                  },
                  {
                    "option": "Expected Salary"
                  },
                  {
                    "option": "Notice Period"
                  },
                  {
                    "option": "Cover Letter"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Custom Questions",
              "fieldType": "textarea",
              "placeholder": "One question per line, e.g.\nWhy do you want to join us?\nAre you open to relocation?"
            },
            {
              "fieldLabel": "Application Deadline",
              "fieldType": "date"
            }
          ]
        },
        "options": {
          "path": "hr-post-job",
          "buttonLabel": "Publish Job"
        }
      },
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ],
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "HR Job Form",
      "webhookId": "a1000000-0000-4000-8000-0000000000aa"
    },
    {
      "parameters": {
        "jsCode": "// Config: change this to your n8n URL (or ngrok / cloud URL so LinkedIn users can reach it)\nconst N8N_BASE_URL = 'http://localhost:5679';\nconst APPLY_FORM_PATH = 'apply-job'; // must match the Form Trigger path in workflow 2\n\nconst item = $input.first();\nconst f = item.json;\n\nconst jobId = 'JOB-' + Date.now().toString(36).toUpperCase();\nconst candidateFields = Array.isArray(f['Candidate Fields'])\n  ? f['Candidate Fields']\n  : String(f['Candidate Fields'] || '').split(',').map(s => s.trim()).filter(Boolean);\n\n// The form stores an uploaded file under a binary key we don't control - normalise it to 'jd'\nconst binKeys = Object.keys(item.binary || {});\nconst binary = binKeys.length ? { jd: item.binary[binKeys[0]] } : undefined;\n\nreturn [{\n  json: {\n    jobId,\n    company: f['Company Name'],\n    title: f['Job Title'],\n    location: f['Location'],\n    employmentType: f['Employment Type'],\n    workMode: f['Work Mode'],\n    experience: f['Experience Required'],\n    skills: f['Required Skills'],\n    description: f['Job Description'],\n    candidateFields: candidateFields.join(', '),\n    customQuestions: (f['Custom Questions'] || '').trim(),\n    deadline: f['Application Deadline'] || '',\n    applyLink: `${N8N_BASE_URL.replace(/\\/$/, '')}/form/${APPLY_FORM_PATH}?Job%20ID=${jobId}`,\n    hasJdFile: binKeys.length > 0\n  },\n  binary\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Prepare Job"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.hasJdFile }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "JD File Uploaded?"
