      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Save Job"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a LinkedIn hiring post for this job.\n\nCompany: {{ $('Job Record').item.json.company }}\nRole: {{ $('Job Record').item.json.job_title }}\nLocation: {{ $('Job Record').item.json.location }} ({{ $('Job Record').item.json.work_mode }})\nType: {{ $('Job Record').item.json.employment_type }}\nExperience: {{ $('Job Record').item.json.experience_required }}\nKey skills: {{ $('Job Record').item.json.required_skills }}\nDeadline: {{ $('Job Record').item.json.deadline || 'Open until filled' }}\nDescription:\n{{ $('Job Record').item.json.job_description.slice(0, 3000) }}\n\nApply link (must appear exactly once, on its own line near the end): {{ $('Job Record').item.json.application_link }}",
        "messages": {
          "messageValues": [
            {
              "message": "You write concise, professional LinkedIn hiring posts. Rules: max 1200 characters; a hook in the first line; 3-5 short bullet points (use the • character) for responsibilities/requirements; a clear call to action with the apply link; 3-5 relevant hashtags at the end. Plain text only, no markdown, no asterisks. Output only the post text."
            }
          ]
        }
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
