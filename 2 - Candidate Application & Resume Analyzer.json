    {
      "parameters": {
        "jsCode": "// Build the candidate form from the fields HR selected for this job\nconst job = $input.first().json;\n\nconst catalog = {\n  'Phone':                { fieldType: 'text', placeholder: '+91 98xxxxxxx' },\n  'College / University': { fieldType: 'text' },\n  'Degree':               { fieldType: 'text', placeholder: 'e.g. B.Tech CSE' },\n  'Graduation Year':      { fieldType: 'number' },\n  'Years of Experience':  { fieldType: 'number' },\n  'Current Company':      { fieldType: 'text' },\n  'LinkedIn Profile':     { fieldType: 'text', placeholder: 'https://linkedin.com/in/...' },\n  'GitHub / Portfolio':   { fieldType: 'text', placeholder: 'https://github.com/...' },\n  'Expected Salary':      { fieldType: 'text' },\n  'Notice Period':        { fieldType: 'text' },\n  'Cover Letter':         { fieldType: 'textarea' },\n};\n\nconst fields = [\n  { fieldLabel: 'Full Name', fieldType: 'text', requiredField: true },\n  { fieldLabel: 'Email', fieldType: 'email', requiredField: true },\n];\n\nconst selected = String(job.candidate_fields || '').split(',').map(s => s.trim()).filter(Boolean);\nfor (const label of selected) {\n  if (catalog[label]) fields.push({ fieldLabel: label, requiredField: true, ...catalog[label] });\n}\n\nconst customQuestions = String(job.custom_questions || '').split('\\n').map(s => s.trim()).filter(Boolean);\nfor (const q of customQuestions) {\n  fields.push({ fieldLabel: q, fieldType: 'textarea', requiredField: true });\n}\n\nfields.push({\n  fieldLabel: 'Resume',\n  fieldType: 'file',\n  requiredField: true,\n  multipleFiles: false,\n  acceptFileTypes: '.pdf,.txt'\n});\n\nreturn [{ json: { formFields: fields, customQuestions, job } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1056,
        496
      ],
      "id": "84d69980-0b1a-4bea-b7d2-d13321cfabdb",
      "name": "Build Candidate Form"
    },
    {
      "parameters": {
