    {
      "parameters": {
        "jsCode": "// Normalise the uploaded resume to binary key 'resume' and detect its type\nconst item = $input.first();\nconst keys = Object.keys(item.binary || {});\nif (!keys.length) throw new Error('No resume file was uploaded');\n\nconst bin = item.binary[keys[0]];\nconst name = bin.fileName || 'resume';\nconst ext = (bin.fileExtension || name.split('.').pop() || '').toLowerCase();\n\nreturn [{\n  json: { answers: item.json, fileName: name, ext },\n  binary: { resume: bin }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1504,
        496
      ],
      "id": "29082de8-efd6-464e-a2ea-a099f034b8d2",
