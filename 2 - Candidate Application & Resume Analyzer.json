    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"candidate_name\": { \"type\": \"string\" },\n    \"email\": { \"type\": \"string\" },\n    \"phone\": { \"type\": \"string\" },\n    \"education\": { \"type\": \"string\" },\n    \"total_experience_years\": { \"type\": \"number\" },\n    \"skills\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n    \"matched_skills\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n    \"missing_skills\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n    \"strengths\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n    \"weaknesses\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n    \"match_score\": { \"type\": \"number\", \"minimum\": 0, \"maximum\": 100 },\n    \"recommendation\": { \"type\": \"string\", \"enum\": [\"Shortlist\", \"Maybe\", \"Reject\"] },\n    \"summary\": { \"type\": \"string\" }\n  },\n  \"required\": [\"candidate_name\", \"email\", \"phone\", \"education\", \"total_experience_years\", \"skills\", \"matched_skills\", \"missing_skills\", \"strengths\", \"weaknesses\", \"match_score\", \"recommendation\", \"summary\"],\n  \"additionalProperties\": false\n}\n"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        2544,
        736
      ],
      "id": "8b7bb3a8-b341-4fa4-ab0b-2307e5cf0e29",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "// Flatten form answers + AI analysis into one data table row\nconst ai = $input.first().json.output || {};\nconst src = $('Standardize Input').first().json;\nconst a = src.answers || {};\nconst job = src.job || {};\nconst customQs = $('Build Candidate Form').first().json.customQuestions || [];\nconst list = v => Array.isArray(v) ? v.join(', ') : String(v || '');\nconst str = v => (v === undefined || v === null) ? '' : String(v);\n\nreturn [{ json: {\n  application_id: 'APP-' + Date.now().toString(36).toUpperCase(),\n  submitted_at: $now.toISO(),\n  job_id: str(job.job_id),\n  job_title: str(job.job_title),\n  candidate_name: str(a['Full Name'] || ai.candidate_name),\n  email: str(a['Email'] || ai.email),\n  phone: str(a['Phone'] || ai.phone),\n  college: str(a['College / University']),\n  degree: str(a['Degree']),\n  graduation_year: str(a['Graduation Year']),\n  years_of_experience: str(a['Years of Experience'] ?? ai.total_experience_years),\n  current_company: str(a['Current Company']),\n  linkedin_profile: str(a['LinkedIn Profile']),\n  github_portfolio: str(a['GitHub / Portfolio']),\n  expected_salary: str(a['Expected Salary']),\n  notice_period: str(a['Notice Period']),\n  custom_answers: customQs.map(q => `${q}: ${a[q] || ''}`).join('\\n'),\n  resume_file: str(src.file_name),\n  education_ai: str(ai.education),\n  skills: list(ai.skills),\n  matched_skills: list(ai.matched_skills),\n  missing_skills: list(ai.missing_skills),\n  strengths: list(ai.strengths),\n  weaknesses: list(ai.weaknesses),\n  match_score: Number(ai.match_score) || 0,\n  recommendation: str(ai.recommendation),\n  ai_summary: str(ai.summary)\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
